# ==============================================================================
# ARTfolio Environment Variables Configuration (.env.example)
#
# IMPORTANT:
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser client bundle.
# - ALL other variables are strictly SERVER-ONLY and must never be exposed to clients.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC / CLIENT-SIDE VARIABLES
# ------------------------------------------------------------------------------

# Canonical Site URL (Used for generating checkout links and metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Public API (PostgreSQL Database client connection)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Razorpay Client Key ID (Public key for Razorpay checkout popup)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_yourkeyid"

# Cloudinary CDN Cloud Name (Used for responsive image optimization)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY PRIVILEGED VARIABLES
# ------------------------------------------------------------------------------

# Supabase Service Role Key (Bypasses RLS - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Admin Authentication & Authorization
# Primary: Admin email allowlist for Supabase Auth verification
ADMIN_NOTIFICATION_EMAIL="admin@yourdomain.com"
# Optional secondary: Admin email fallback
ADMIN_EMAIL="admin@yourdomain.com"
# Machine-to-Machine Secret (Used for automated/internal admin endpoints via Authorization: Bearer <secret>)
ADMIN_API_SECRET="your_secure_random_admin_api_secret"
ADMIN_API_KEY="your_secure_random_admin_api_secret"

# Razorpay Payment Gateway (Server-Side Execution & Signature Verification)
RAZORPAY_KEY_ID="rzp_test_yourkeyid"
RAZORPAY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Cloudinary Media Storage (Server-Only Uploads & Deletion)
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Transactional Email (Resend)
RESEND_API_KEY="re_yourresendkey"
RESEND_FROM_EMAIL="curator@yourdomain.com"

# Distributed Rate Limiting (Upstash Redis)
# Fallback to bounded in-memory rate limiting occurs if not configured
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"

# Cron Job Authorization Key (Secures /api/cron/* endpoints)
CRON_SECRET="your_secure_random_cron_secret"

# Privacy-Preserving View Telemetry Salt (Used for SHA-256 IP hashing)
TELEMETRY_SALT="your_secure_random_telemetry_salt"
